# ==============================================================================
# WLUG Open Source Day 2026 — Backend Environment Variables
# ==============================================================================

# Gmail SMTP Authentication (Use a 16-character Google App Password, NOT your regular password)
EMAIL_USER=y
EMAIL_APP_PASSWORD=your-google-app-password
EMAIL_FROM_NAME=OSD 2K26 Team

# Frontend URL for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://osd.wlug.in)
FRONTEND_URL=http://localhost:5173

# Server Port (Render sets PORT automatically)
PORT=5000


