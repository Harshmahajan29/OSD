# ==============================================================================
# WLUG Open Source Day 2026 — Frontend Environment Variables
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real keys:
# cp .env.example .env
#
# Vite exposes variables prefixed with VITE_ to the browser client.

# Supabase Project URL (from your Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (from Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Table Name for event registrations (default: registrations)
VITE_SUPABASE_TABLE=registrations
