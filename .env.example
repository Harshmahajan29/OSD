# ==============================================================================
# WLUG Open Source Day 2026 — Root Environment Variables Example
# ==============================================================================

# --- Frontend (Supabase Client & Backend API URL) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_SUPABASE_TABLE=registrations
VITE_BACKEND_URL=http://localhost:5000

# --- Backend (Nodemailer Gmail SMTP & Server Config) ---
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-google-app-password
EMAIL_FROM_NAME=OSD 2K26 Team
FRONTEND_URL=http://localhost:5173
PORT=5000
